<?xml version="1.0"?>
<TriggernometryExport Version="1">
  <ExportedFolder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0001-4000-8000-000000000001" Name="FF14 Discord Notify (Portable)" Enabled="true">
    <Folders>

      <!-- ======================================== -->
      <!-- [1] Settings - 설정 -->
      <!-- ======================================== -->
      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0002-4000-8000-000000000001" Name="[1] Settings - 설정" Enabled="true">
        <Folders />
        <Triggers>
          <Trigger Enabled="true" Source="Log" Name="Set Webhook URL" Id="a1b2c3d4-0010-4000-8000-000000000002" RegularExpression="^.*?00:0038::!notify_set (?&lt;url&gt;https://discord\.com/api/webhooks/[\w\-/]+)">
            <Actions>
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14notify_webhook" VariableOp="SetString" VariableExpression="${url}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <Action OrderNumber="2" ActionType="GenericJson" JsonEndpointExpression="${url}" JsonPayloadExpression="{&quot;content&quot;:&quot;Webhook Linked!&quot;}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>
          <Trigger Enabled="true" Source="Log" Name="Unset Webhook (OFF)" Id="a1b2c3d4-0010-4000-8000-000000000003" RegularExpression="^.*?00:0038::!notify_off">
            <Actions>
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14notify_webhook" VariableOp="Unset">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>
        </Triggers>
      </Folder>

      <!-- ======================================== -->
      <!-- [2] Alerts - 알림 -->
      <!-- ======================================== -->
      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0003-4000-8000-000000000001" Name="[2] Alerts - 알림" Enabled="true">
        <Folders />
        <Triggers>
          <!-- 듀티 매칭 -->
          <Trigger Enabled="true" Source="Log" Name="Duty Matched" Id="a1b2c3d4-0020-4000-8000-000000000001" RegularExpression="^.*?00:0039::(?&lt;content&gt;.*임무에 참가를 신청했습니다.*)">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Duty Matched&quot;,&quot;description&quot;:&quot;${content}&quot;,&quot;color&quot;:16711680}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>

          <!--
            파티원 참가 (서버 초월) - 직업 포함
            동작 순서:
            1) 이름/서버 변수 저장
            2) 직업 변수 초기화 (알 수 없음)
            3) 3초 대기 → 이 사이에 [Job] AddCombatant 트리거가 직업 변수를 채움
            4) 웹훅 전송 (직업 포함)
          -->
          <Trigger Enabled="true" Source="Log" Name="Party Join (Server)" Id="a1b2c3d4-0020-4000-8000-000000000010" RegularExpression="^.*?00:(2039|2239)::(?&lt;name&gt;.+)(?&lt;server&gt;카벙클|초코보|모그리|톤베리|펜리르) 님이 파티에 (참가|참여)했습니다\.">
            <Actions>
              <!-- 1: 대기 대상 이름 저장 -->
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14_pjob_pending_name" VariableOp="SetString" VariableExpression="${name}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <!-- 2: 직업 변수 초기화 -->
              <Action OrderNumber="2" ActionType="Variable" VariableName="ff14_pjob_value" VariableOp="SetString" VariableExpression="알 수 없음">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <!-- 3: 3초 대기 (AddCombatant가 직업 채울 시간) -->
              <Action OrderNumber="3" ActionType="Sleep" Duration="3000">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <!-- 4: 웹훅 전송 (직업 포함) -->
              <Action OrderNumber="4" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Party Join&quot;,&quot;description&quot;:&quot;**${name}@${server}**\n직업: ${var:ff14_pjob_value}&quot;,&quot;color&quot;:3066993}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>

          <!-- 파티원 참가 (로컬) - 직업 포함 -->
          <Trigger Enabled="true" Source="Log" Name="Party Join (Local)" Id="a1b2c3d4-0020-4000-8000-000000000011" RegularExpression="^.*?00:(2039|2239)::(?&lt;name&gt;(?!.*(?:카벙클|초코보|모그리|톤베리|펜리르) 님이).+?) 님이 파티에 (참가|참여)했습니다\.">
            <Actions>
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14_pjob_pending_name" VariableOp="SetString" VariableExpression="${name}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <Action OrderNumber="2" ActionType="Variable" VariableName="ff14_pjob_value" VariableOp="SetString" VariableExpression="알 수 없음">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <Action OrderNumber="3" ActionType="Sleep" Duration="3000">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
              <Action OrderNumber="4" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Party Join&quot;,&quot;description&quot;:&quot;**${name}**\n직업: ${var:ff14_pjob_value}&quot;,&quot;color&quot;:3066993}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>

          <!-- 파티원 퇴장 (서버) -->
          <Trigger Enabled="true" Source="Log" Name="Party Leave (Server)" Id="a1b2c3d4-0020-4000-8000-000000000012" RegularExpression="^.*?00:(2039|2239|0039)::(?&lt;name&gt;.+)(?&lt;server&gt;카벙클|초코보|모그리|톤베리|펜리르) 님[이을의] 파티에서 탈퇴했습니다\.">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Party Leave&quot;,&quot;description&quot;:&quot;**${name}@${server}** left&quot;,&quot;color&quot;:15158332}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>

          <!-- 파티원 퇴장 (로컬) -->
          <Trigger Enabled="true" Source="Log" Name="Party Leave (Local)" Id="a1b2c3d4-0020-4000-8000-000000000013" RegularExpression="^.*?00:(2039|2239|0039)::(?&lt;name&gt;(?!.*(?:카벙클|초코보|모그리|톤베리|펜리르) 님).+?) 님[이을의] 파티에서 탈퇴했습니다\.">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Party Leave&quot;,&quot;description&quot;:&quot;**${name}** left&quot;,&quot;color&quot;:15158332}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>

          <!-- 파티 해산 -->
          <Trigger Enabled="true" Source="Log" Name="Party Disband" Id="a1b2c3d4-0020-4000-8000-000000000014" RegularExpression="^.*?00:(2039|2239|0039)::(서버 초월 파티(를|가) 해체(했|되었)습니다|파티(를|가) 해체(했|되었)습니다)\.">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;Party Leave&quot;,&quot;description&quot;:&quot;파티가 해산되었습니다.&quot;,&quot;color&quot;:15158332}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>
        </Triggers>
      </Folder>

      <!-- ======================================== -->
      <!-- [3] Party Chat - 파티 채팅 -->
      <!-- ======================================== -->
      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0004-4000-8000-000000000001" Name="[3] Party Chat - 파티 채팅" Enabled="true">
        <Folders />
        <Triggers>
          <Trigger Enabled="true" Source="Log" Name="Party Chat (Server)" Id="a1b2c3d4-0030-4000-8000-000000000010" RegularExpression="^.*?00:000[eE]:(?&lt;name&gt;.+)(?&lt;server&gt;카벙클|초코보|모그리|톤베리|펜리르):(?&lt;msg&gt;.*)">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;content&quot;:&quot;**${name}@${server}**: ${msg}&quot;}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>
          <Trigger Enabled="true" Source="Log" Name="Party Chat (Local)" Id="a1b2c3d4-0030-4000-8000-000000000011" RegularExpression="^.*?00:000[eE]:(?&lt;name&gt;(?!.*(?:카벙클|초코보|모그리|톤베리|펜리르):)[^:]+):(?&lt;msg&gt;.*)">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;content&quot;:&quot;**${name}**: ${msg}&quot;}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>
        </Triggers>
      </Folder>

      <!-- ======================================== -->
      <!-- [4] Test - 테스트 -->
      <!-- ======================================== -->
      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0005-4000-8000-000000000001" Name="[4] Test - 테스트" Enabled="true">
        <Folders />
        <Triggers>
          <Trigger Enabled="true" Source="Log" Name="Test Send" Id="a1b2c3d4-0040-4000-8000-000000000001" RegularExpression="!ff14notify_test">
            <Actions>
              <Action OrderNumber="1" ActionType="GenericJson" JsonEndpointExpression="${var:ff14notify_webhook}" JsonPayloadExpression="{&quot;embeds&quot;:[{&quot;title&quot;:&quot;FF14 Discord Notify - Test&quot;,&quot;description&quot;:&quot;Webhook OK!&quot;,&quot;color&quot;:3066993}]}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <Condition Enabled="false" Grouping="Or" />
            <Conditions />
          </Trigger>
        </Triggers>
      </Folder>

      <!-- ======================================== -->
      <!-- [5] Job Tracker - 직업 추적 (내부용) -->
      <!-- 직업 id → 이름 변환 후 ff14_pjob_value 변수에 저장 -->
      <!-- Party Join 트리거의 3초 Sleep 사이에 실행되어야 함    -->
      <!-- ======================================== -->
      <Folder FFXIVJobFilterEnabled="false" FFXIVJobFilter="0" ZoneFilterEnabled="false" EventFilterEnabled="false" Id="a1b2c3d4-0006-4000-8000-000000000001" Name="[5] Job Tracker - 직업 추적" Enabled="true">
        <Folders />
        <Triggers>
          <!--
            AddCombatant 로그라인 (type 03) 에서 직업 캡처
            형식: [시간] 03:EntityID:Name:Level:JobHex:HP:MaxHP:...
            조건: 캡처된 이름 == ff14_pjob_pending_name 변수값일 때만 직업 저장
          -->
          <Trigger Enabled="true" Source="Log" Name="[Job] AddCombatant - Job Capture" Id="a1b2c3d4-0050-4000-8000-000000000001" RegularExpression="^.*?03:[0-9A-Fa-f]+:(?&lt;name&gt;[^:]+):[0-9A-Fa-f]+:(?&lt;jobhex&gt;[0-9A-Fa-f]+):">
            <Actions>
              <!--
                이름이 대기 중인 파티원과 일치할 때만 직업 저장
                C# 인라인으로 jobhex(16진수) → 직업 한글명 변환
              -->
              <Action OrderNumber="1" ActionType="Variable" VariableName="ff14_pjob_value" VariableOp="SetString"
                VariableExpression="${_cs:new System.Collections.Generic.Dictionary&lt;int,string&gt;{{19,&quot;팔라딘&quot;},{20,&quot;승려&quot;},{21,&quot;전사&quot;},{22,&quot;용기사&quot;},{23,&quot;음유시인&quot;},{24,&quot;백마도사&quot;},{25,&quot;흑마도사&quot;},{27,&quot;소환사&quot;},{28,&quot;학자&quot;},{30,&quot;닌자&quot;},{31,&quot;기공사&quot;},{32,&quot;암흑기사&quot;},{33,&quot;점성술사&quot;},{34,&quot;사무라이&quot;},{35,&quot;적마도사&quot;},{37,&quot;건브레이커&quot;},{38,&quot;무도가&quot;},{39,&quot;리퍼&quot;},{40,&quot;현자&quot;},{41,&quot;바이퍼&quot;},{42,&quot;회화술사&quot;}}.TryGetValue(Convert.ToInt32(&quot;${jobhex}&quot;,16),out var j)?j:&quot;알 수 없음&quot;}">
                <Condition Enabled="false" Grouping="Or" />
                <Conditions />
              </Action>
            </Actions>
            <!-- 이름이 대기 중인 이름과 일치할 때만 실행 -->
            <Condition Enabled="true" Grouping="And" />
            <Conditions>
              <Condition Enabled="true" Expression="${name}" Op="Equal" Operand="${var:ff14_pjob_pending_name}" />
            </Conditions>
          </Trigger>
        </Triggers>
      </Folder>

    </Folders>
    <Triggers />
  </ExportedFolder>
</TriggernometryExport>
